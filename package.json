{
  "name": "neural_network-rag-01",
  "version": "1.0.0",
  "description": "My first RAG application, created using Node.JS, LangChain, Neo4j and OpenRouter.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node --env-file .env --experimental-strip-types src/index.ts",
    "dev": "node --no-warnings --env-file .env --watch --experimental-strip-types src/index.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down --volumes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cMatheusBRibeiro/neural_network-rag-01.git"
  },
  "keywords": [
    "RAG",
    "Node",
    "Neo4j",
    "LangChain",
    "NeuralNetwork"
  ],
  "author": "Matheus Braga Ribeiro",
  "license": "MIT",
  "dependencies": {
    "@huggingface/inference": "^4.13.18",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@xenova/transformers": "^2.17.2",
    "neo4j-driver": "^6.0.1",
    "pdf-parse": "^2.4.5"
  }
}
